# 複製此檔為 terraform.tfvars 並填入實際值，terraform.tfvars 不應提交到版控（已列於 .gitignore）

aws_region   = "ap-northeast-1"
project_name = "aimom"
environment  = "dev"

meeting_retention_days = 14
admin_emails           = "you@example.com,teammate@example.com"

google_client_id     = "your-google-oauth-client-id.apps.googleusercontent.com"
google_client_secret = "your-google-oauth-client-secret"

frontend_callback_urls = ["https://your-cloudfront-domain.cloudfront.net"]
frontend_logout_urls   = ["https://your-cloudfront-domain.cloudfront.net"]

llm_engine   = "bedrock-proxy"
llm_model    = "mistral.mistral-large-3-675b-instruct"
github_token = "your-github-pat-with-models-scope"
bedrock_proxy_base_url = "https://your-bedrock-proxy.example/v1"
bedrock_proxy_api_key   = "your-bedrock-proxy-api-key"

assemblyai_api_key = "your-assemblyai-api-key"

lambda_memory_size = 1024
lambda_timeout     = 30
