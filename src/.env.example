# AssemblyAI (v2.0 — 語音轉錄 + 說話者識別)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_MODEL=universal-2          # universal-2（推薦）或 universal-3-5-pro（更高精準度，較貴）
ASSEMBLYAI_SPEAKER_DIARIZATION=true   # 說話者識別（+$0.02/hr）

# LLM（會議紀錄整理）
# LLM_ENGINE 可選：
#   - "github-models"（預設，使用 GitHub Models，需 Copilot Business/Enterprise 帳號較佳）
#   - "openai-gpt4o"（原本的 OpenAI 官方 API 做法，保留可切換）
#   - "groq"（Groq，成本低、速度快，如 Llama-3.3-70B）
#   - "gemini"（Google Gemini，有免費額度）
#   - "bedrock-proxy"（OpenAI 相容的 Bedrock proxy，透過 API key + base URL）
LLM_ENGINE=bedrock-proxy
LLM_MODEL=                    # 留空則依 LLM_ENGINE 使用預設模型（bedrock-proxy 預設 mistral.mistral-large-3-675b-instruct；也可手動覆寫）
GITHUB_TOKEN=ghp_...           # LLM_ENGINE=github-models 時使用，PAT 需勾選 "models" scope
OPENAI_API_KEY=sk-...          # LLM_ENGINE=openai-gpt4o 時使用
GROQ_API_KEY=gsk_...           # LLM_ENGINE=groq 時使用，於 https://console.groq.com/keys 建立
GEMINI_API_KEY=...             # LLM_ENGINE=gemini 時使用，於 https://aistudio.google.com/apikey 建立
BEDROCK_PROXY_BASE_URL=https://your-bedrock-proxy.example/v1
BEDROCK_PROXY_API_KEY=...      # LLM_ENGINE=bedrock-proxy 時使用

# 限制
MAX_DURATION_HOURS=2

# 暫存資料夾
TMP_DIR=tmp

# 音檔暫存 S3 bucket（TASK-015 — presigned URL 直傳）
# 本機開發若未設定，/upload/presign、/upload/complete 會回傳 500，仍可用舊版 /upload 直傳端點測試
AUDIO_BUCKET_NAME=
AUDIO_PRESIGN_EXPIRES_SEC=600
